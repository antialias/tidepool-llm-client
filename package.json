{
  "name": "@tidepool/llm-client",
  "version": "1.6.0",
  "description": "Type-safe LLM client with multi-provider support, Zod schema validation, streaming, embeddings, and retry logic",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./dsl": {
      "types": "./dist/dsl.d.ts",
      "import": "./dist/dsl.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./intent-registry": {
      "types": "./dist/intent-registry.d.ts",
      "import": "./dist/intent-registry.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js"
    },
    "./middleware/persistence": {
      "types": "./dist/middleware/persistence.d.ts",
      "import": "./dist/middleware/persistence.js"
    },
    "./operations": {
      "types": "./dist/operations.d.ts",
      "import": "./dist/operations.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.js"
    },
    "./providers/anthropic": {
      "types": "./dist/providers/anthropic.d.ts",
      "import": "./dist/providers/anthropic.js"
    },
    "./providers/base": {
      "types": "./dist/providers/base.d.ts",
      "import": "./dist/providers/base.js"
    },
    "./providers/openai": {
      "types": "./dist/providers/openai.d.ts",
      "import": "./dist/providers/openai.js"
    },
    "./providers/openai-dsl": {
      "types": "./dist/providers/openai-dsl.d.ts",
      "import": "./dist/providers/openai-dsl.js"
    },
    "./providers/openai-responses": {
      "types": "./dist/providers/openai-responses.d.ts",
      "import": "./dist/providers/openai-responses.js"
    },
    "./retry": {
      "types": "./dist/retry.d.ts",
      "import": "./dist/retry.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc -p tsconfig.build.json -w --preserveWatchOutput",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^2.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/antialias/tidepool-llm-client.git"
  }
}
